# Salin file ini menjadi .env.local lalu isi nilainya.
# Semua nilai ada di Supabase Dashboard > Project Settings > API Keys.

# URL project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_...) atau legacy "anon" key.
# Aman dipakai di browser: semua akses tetap dibatasi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secret key (sb_secret_...) atau legacy "service_role" key.
# RAHASIA: melewati RLS. Jangan diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Akun admin demo yang dibuat oleh `npm run seed`.
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=ganti-dengan-password-kuat
