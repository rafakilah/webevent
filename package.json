{
  "name": "webevent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:race": "tsx --env-file=.env.local scripts/race-test.ts",
